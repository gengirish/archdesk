// ArchDesk — Prisma Schema
// Run: npx prisma db push   (to sync with Supabase)
// Run: npx prisma studio    (to browse data)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// FIRM (tenant root — every query scopes to this)
// ─────────────────────────────────────────────
model Firm {
  id          String   @id @default(cuid())
  name        String
  logo        String?
  gstNumber   String?
  phone       String
  email       String
  address     String?
  city        String   @default("Hubbali")
  state       String   @default("Karnataka")
  brandColor  String   @default("#E8A045")
  website     String?
  plan        String   @default("free")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users    User[]
  clients  Client[]
  projects Project[]
  leads    Lead[]
  vendors  Vendor[]

  @@map("firms")
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────
model User {
  id      String @id @default(cuid())
  clerkId String @unique
  firmId  String
  firm    Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  name   String
  email  String
  phone  String?
  role   UserRole @default(ARCHITECT)
  avatar String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectMembers ProjectMember[]
  siteUpdates    SiteUpdate[]
  drawingComments DrawingComment[]
  leadActivities LeadActivity[]
  clientNudges   ClientNudge[]

  @@map("users")
}

enum UserRole {
  OWNER
  ARCHITECT
  DRAFTSMAN
  SITE_MANAGER
  ADMIN
}

// ─────────────────────────────────────────────
// CLIENT
// ─────────────────────────────────────────────
model Client {
  id     String @id @default(cuid())
  firmId String
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  name    String
  phone   String
  email   String?
  address String?
  city    String?
  // Indian state/UT name; compared with Firm.state to choose CGST+SGST vs IGST.
  state   String?
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@map("clients")
}

// ─────────────────────────────────────────────
// PROJECT
// ─────────────────────────────────────────────
model Project {
  id       String @id @default(cuid())
  firmId   String
  firm     Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  name        String
  description String?
  type        ProjectType
  stage       ProjectStage @default(CONCEPT)
  status      ProjectStatus @default(ACTIVE)

  budget    Float?
  area      Float?   // sqft
  location  String?
  startDate DateTime?
  deadline  DateTime?

  // Token for client portal (public, no auth). Generated by lib/portal-token.ts
  // (32 random bytes, base64url). No DB default: callers must set it.
  clientToken String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team        ProjectMember[]
  drawings    Drawing[]
  floorPlans  FloorPlan[]
  flatScenes  FlatScene[]
  milestones  Milestone[]
  clientDecisions ClientDecision[]
  clientNudges ClientNudge[]
  siteUpdates SiteUpdate[]
  issues      SiteIssue[]

  @@map("projects")
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  INTERIOR
  LANDSCAPE
  INSTITUTIONAL
}

enum ProjectStage {
  CONCEPT
  SCHEMATIC
  DESIGN_DEV
  WORKING_DRAWINGS
  EXECUTION
  COMPLETED
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  role      String  @default("Architect")

  @@unique([projectId, userId])
  @@map("project_members")
}

// ─────────────────────────────────────────────
// DRAWINGS
// ─────────────────────────────────────────────
model Drawing {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name     String
  type     DrawingType
  fileUrl  String
  fileSize Int?         // bytes
  mimeType String?
  version  Int          @default(1)
  status   DrawingStatus @default(PENDING_REVIEW)

  uploadedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions DrawingVersion[]
  comments DrawingComment[]

  @@map("drawings")
}

model DrawingVersion {
  id        String  @id @default(cuid())
  drawingId String
  drawing   Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  version  Int
  fileUrl  String
  fileSize Int?
  note     String?

  createdAt DateTime @default(now())

  @@map("drawing_versions")
}

model DrawingComment {
  id        String  @id @default(cuid())
  drawingId String
  drawing   Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])

  // For client comments (no user account)
  clientName String?
  content    String
  isClient   Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("drawing_comments")
}

enum DrawingType {
  PLAN
  ELEVATION
  SECTION
  RENDER
  BOQ
  DETAIL
  OTHER
}

enum DrawingStatus {
  PENDING_REVIEW
  APPROVED
  REVISION_REQUESTED
}

// ─────────────────────────────────────────────
// 3D STUDIO — FLOOR PLAN & SCENES
// ─────────────────────────────────────────────
model FloorPlan {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  sourceType  FloorPlanSourceType @default(MANUAL)
  unit        String @default("mm")
  scale       Float  @default(1)
  wallHeight  Float  @default(3000)
  wallThickness Float @default(200)

  // Canonical 2D data represented as normalized JSON.
  // Expected shape:
  // {
  //   "polygon": [{ "x": 0, "y": 0 }, ...],
  //   "walls": [{ "start": { "x": 0, "y": 0 }, "end": { "x": 1000, "y": 0 } }, ...]
  // }
  planJson Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scenes FlatScene[]

  @@index([projectId, createdAt])
  @@map("floor_plans")
}

enum FloorPlanSourceType {
  MANUAL
  DXF
  PDF
  IMAGE
}

model FlatScene {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  floorPlanId String?
  floorPlan   FloorPlan? @relation(fields: [floorPlanId], references: [id], onDelete: SetNull)

  name   String
  status FlatSceneStatus @default(DRAFT)

  // 3D scene payload used by Babylon.js renderer.
  sceneJson Json
  generationMeta Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
  @@index([floorPlanId])
  @@map("flat_scenes")
}

enum FlatSceneStatus {
  DRAFT
  GENERATED
  FAILED
}

// ─────────────────────────────────────────────
// BILLING — MILESTONES & INVOICES
// ─────────────────────────────────────────────
model Milestone {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  description String?
  stage       ProjectStage
  amount      Float         // base amount before GST
  gstPercent  Float        @default(18)
  dueDate     DateTime?

  // Razorpay
  razorpayLinkId  String?
  razorpayLinkUrl String?

  status    MilestoneStatus @default(UPCOMING)
  paidAt    DateTime?
  paidAmount Float?
  clientDecisionOpen Boolean @default(false)
  clientDecisionOpenedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]
  clientDecisions ClientDecision[]
  clientNudges ClientNudge[]

  @@map("milestones")
}

model Invoice {
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id])

  // Owning firm (denormalised from milestone → project) so numbers are unique per firm.
  firmId      String?
  invoiceNo   String          // e.g. ARC-2026-001
  baseAmount  Float
  gstAmount   Float
  totalAmount Float
  pdfUrl      String?
  notes       String?

  status  InvoiceStatus @default(UNPAID)
  paidAt  DateTime?

  // Razorpay payment details
  razorpayPaymentId String?
  razorpayOrderId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([firmId, invoiceNo])
  @@map("invoices")
}

// Gap-free invoice counter per firm per calendar year (see lib/invoice-number.ts).
model InvoiceSequence {
  firmId String
  year   Int
  last   Int    @default(0)

  @@id([firmId, year])
  @@map("invoice_sequences")
}

model ClientDecision {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  outcome ClientDecisionOutcome
  comment String

  // Optional cost impact communicated during client decision.
  costDeltaAmount Float?
  costDeltaNote   String?
  respondentName  String?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([milestoneId, createdAt])
  @@map("client_decisions")
}

enum ClientDecisionOutcome {
  APPROVED
  REJECTED
}

model ClientNudge {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  requestedById String?
  requestedBy   User? @relation(fields: [requestedById], references: [id])

  channel ClientNudgeChannel
  status  ClientNudgeStatus @default(QUEUED)

  provider        String
  providerMessageId String?
  idempotencyKey  String?
  message         String?
  errorMessage    String?
  metadata        Json?

  sentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
  @@index([milestoneId, createdAt])
  @@index([status, createdAt])
  @@map("client_nudges")
}

enum ClientNudgeChannel {
  EMAIL
  WHATSAPP
}

enum ClientNudgeStatus {
  QUEUED
  SENT
  FAILED
}

enum MilestoneStatus {
  UPCOMING
  DUE
  UNPAID
  PAID
  OVERDUE
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}

// ─────────────────────────────────────────────
// SITE TRACKER
// ─────────────────────────────────────────────
model SiteUpdate {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])

  note        String?
  photos      String[] // Supabase storage URLs
  milestone   ProjectStage?
  weather     String?

  createdAt DateTime @default(now())

  @@map("site_updates")
}

model SiteIssue {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String?
  photos      String[]
  severity    IssueSeverity @default(MEDIUM)
  status      IssueStatus   @default(OPEN)
  assignedTo  String?       // user name or team member

  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("site_issues")
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ─────────────────────────────────────────────
// LEADS CRM
// ─────────────────────────────────────────────
model Lead {
  id     String @id @default(cuid())
  firmId String
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  name        String
  phone       String
  email       String?
  address     String?
  projectType ProjectType?
  budget      Float?
  area        Float?       // sqft
  source      LeadSource   @default(OTHER)
  stage       LeadStage    @default(NEW)
  notes       String?
  followUpAt  DateTime?

  // Won lead → converted project
  convertedProjectId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]

  @@map("leads")
}

model LeadActivity {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId String?
  user   User?  @relation(fields: [userId], references: [id])

  type    ActivityType
  note    String?

  createdAt DateTime @default(now())

  @@map("lead_activities")
}

enum LeadSource {
  REFERRAL
  INSTAGRAM
  FACEBOOK
  WALKIN
  WEBSITE
  HOUZZ
  PHONE
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  SITE_VISIT
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  WHATSAPP
  SITE_VISIT
  PROPOSAL
  NOTE
  MEETING
  STAGE_CHANGE
}

// ─────────────────────────────────────────────
// VENDORS
// ─────────────────────────────────────────────
model Vendor {
  id     String @id @default(cuid())
  firmId String
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  name     String
  category VendorCategory
  phone    String
  email    String?
  address  String?
  city     String         @default("Hubbali")
  gst      String?
  notes    String?
  rating   Int?           // 1-5

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vendors")
}

enum VendorCategory {
  CONTRACTOR
  TILES
  STEEL
  WOOD
  GLASS
  ELECTRICAL
  PLUMBING
  PAINT
  HARDWARE
  FURNITURE
  LANDSCAPING
  OTHER
}
