# ArchDesk — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ─── DATABASE (Supabase) ──────────────────────────────────────
# Get from: https://supabase.com → Project Settings → Database
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ─── SUPABASE (Storage & Client) ─────────────────────────────
# Get from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ─── CLERK (Authentication) ───────────────────────────────────
# Get from: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# ─── RAZORPAY (Payments) ──────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-secret-here"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."

# Webhook secret — set in Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# ─── RESEND (Email) ───────────────────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY="re_..."
EMAIL_FROM="ArchDesk <noreply@yourdomain.com>"

# ─── APP ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
