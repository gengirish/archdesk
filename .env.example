# ArchDesk — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ─── DATABASE (Neon Postgres) ─────────────────────────────────
# Get from: Neon console → Connection details (pooled URL for DATABASE_URL)
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/neondb?sslmode=require"

# ─── FILE STORAGE (Vercel Blob, public store) ─────────────────
# Drawings, site photos, firm logos. Connect a Blob store to the Vercel project
# (Storage → Create → Blob, access: Public), then: vercel env pull .env.local
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ─── CLERK (Authentication) ───────────────────────────────────
# Get from: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SIGNING_SECRET=

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ─── RAZORPAY (Payments) ──────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-secret-here"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."

# Webhook secret — set in Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# ─── AGENTMAIL (Email, preferred) ─────────────────────────────
# Get from: https://console.agentmail.to → API Keys. The inbox id IS the
# inbox's email address (e.g. archdesk@agentmail.to or notify@yourdomain.com).
# When both are set, AgentMail is used; otherwise falls back to Resend below.
AGENTMAIL_API_KEY=
AGENTMAIL_FROM_INBOX_ID=
# Optional: https://api.agentmail.eu for EU region; request timeout in ms (default 8000)
AGENTMAIL_BASE_URL=
AGENTMAIL_TIMEOUT_MS=

# ─── RESEND (Email, legacy fallback) ──────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY="re_..."
EMAIL_FROM="ArchDesk <noreply@yourdomain.com>"

# ─── E2E TESTING (Playwright) ─────────────────────────────────
# Clerk demo account for authenticated E2E tests
E2E_CLERK_USER_EMAIL="priya@designcraft.in"
E2E_CLERK_USER_PASSWORD="Demo@2026"

# ─── APP ─────────────────────────────────────────────────────
# Plan for firms created at sign-up (free | pro | enterprise). Defaults to free.
# Set to "enterprise" during the beta so new testers get every feature.
SIGNUP_DEFAULT_PLAN=
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
